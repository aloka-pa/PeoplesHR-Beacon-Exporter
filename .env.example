# Copy this file to .env and fill in values for your environment.
# .env is gitignored and must never be committed.

# Base URL of Beacon Agent Studio
BEACON_BASE_URL=https://studio.beacon.li

# Entry page used to start discovery / exports (Tools list)
BEACON_TOOLS_URL=https://studio.beacon.li/agent-studio/tools

# Directory for the persistent Playwright/Chromium profile (gitignored).
# Keeping this outside the repo root is also fine; it just needs to be a
# stable path so your login session is reused between runs.
BROWSER_PROFILE_DIR=./browser-profile

# Optional: run discovery/export browser headless once you trust the flow.
# Manual login requires headless=false at least once.
BEACON_HEADLESS=false

# Optional: override the "representative tool" name suggested during
# discovery and used for the Phase-2 smoke test.
BEACON_SAMPLE_TOOL_NAME=submitSubordinatesManualInAndOut
