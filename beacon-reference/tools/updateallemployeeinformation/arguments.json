    {
      "name": "OtherDetailInfo",
      "type": "array",
      "required": true,
      "defaultValue": [],
      "description": "Array of employee additional attributes and custom fields",
      "advanced": true,
      "raw": {
        "type": "array",
        "description": "Array of employee additional attributes and custom fields",
        "items": {
          "type": "object",
          "properties": {
            "EmpNumber": {
              "type": "string",
              "description": "Encrypted/encoded employee identification number",
              "default": ""
            },
            "AttributeCode": {
              "type": "string",
              "description": "Unique code identifying the type of attribute (e.g., 000005 for Meal Preference)",
              "default": ""
            },
            "AttributeDispOrder": {
              "type": "string",
              "description": "Display order number for UI presentation of attributes",
              "default": ""
            },
            "AttributeName": {
              "type": "string",
              "description": "Human-readable name of the attribute (e.g., 'Meal Preference', 'Vaccination Status')",
              "default": ""
            },
            "AttributeValue": {
              "type": "string",
              "description": "Primary value of the attribute, can be null if not populated",
              "default": ""
            },
            "AttributeDateValue": {
              "type": "string",
              "description": "Date representation of the attribute value, matches AttributeValue for non-date types",
              "default": ""
            },
            "AttributeStringValue": {
              "type": "string",
              "description": "String representation of the attribute value, matches AttributeValue",
              "default": ""
            },
            "AttributeBooleanValue": {
              "type": "string",
              "description": "Boolean representation of the attribute value as string",
              "default": ""
            },
            "AttributeNumericValue": {
              "type": "string",
              "description": "Numeric representation of the attribute value as string",
              "default": ""
            },
            "AttributeDataType": {
              "type": "string",
              "description": "Data type of the attribute (String, Boolean, Date, Numeric)",
              "enum": [
                "String",
                "Boolean",
                "Date",
                "Numeric"
              ],
              "default": "String"
            },
            "AttributeDisplayType": {
              "type": "string",
              "description": "Type defining how attribute should be displayed in UI (0, 1, 2)",
              "default": "0"
            },
            "AttributeEditType": {
              "type": "string",
              "description": "Type defining how attribute can be edited (0, 1, 2)",
              "default": "0"
            },
            "ActionType": {
              "type": "string",
              "description": "Action type for the attribute operation",
              "default": "0"
            },
            "UpdateInsert": {
              "type": "string",
              "description": "Flag indicating update or insert operation",
              "default": "0"
            }
          },
          "required": [
            "EmpNumber",
            "AttributeCode",
            "AttributeDispOrder",
            "AttributeName",
            "AttributeValue",
            "AttributeDateValue",
            "AttributeStringValue",
            "AttributeBooleanValue",
            "AttributeNumericValue",
            "AttributeDataType",
            "AttributeDisplayType",
            "AttributeEditType",
            "ActionType",
            "UpdateInsert"
          ]
        },
        "default": []
      }
    },
